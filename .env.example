DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"
JWT_SECRET="change-me-in-production"
# Powers the AI chat assistant (src/app/api/chat/route.ts). Get one at
# https://aistudio.google.com/apikey — without it the widget still renders
# but replies with a "not activated yet" message instead of erroring.
GEMINI_API_KEY=""

# Lead dual-sync (src/lib/leads/sync.ts): every lead is always saved to the
# database regardless of these — set them to also mirror leads into one
# permanent Google Sheet and notify a WhatsApp number. Leave any of them
# unset and that one destination is skipped (status "NOT_CONFIGURED"),
# nothing else breaks.

# Google Sheets — create a Google Cloud service account, share your existing
# permanent spreadsheet with its email (Editor access), then set:
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_NAME="Leads"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Paste the service account's private key exactly as issued (including
# "-----BEGIN PRIVATE KEY-----" / "-----END PRIVATE KEY-----"); \n line
# breaks in an env var are fine, the app un-escapes them automatically.
GOOGLE_PRIVATE_KEY=""

# WhatsApp — official Meta WhatsApp Cloud API (business.facebook.com),
# never an unofficial automation method.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
# The staff/business number (with country code, no "+") that should receive
# new-lead alerts, e.g. "919835266017".
WHATSAPP_NOTIFY_TO=""
