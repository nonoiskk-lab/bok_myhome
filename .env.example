DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"
JWT_SECRET="change-me-in-production"
# Powers the AI chat assistant (src/app/api/chat/route.ts). Get one at
# https://aistudio.google.com/apikey — without it the widget still renders
# but replies with a "not activated yet" message instead of erroring.
GEMINI_API_KEY=""

# The CRM database (Customer/Lead/Followup/Activity tables) is the sole
# source of truth for every lead — set these only to ALSO send a WhatsApp
# alert to staff about a new lead (a communication channel, not storage).
# Leave any unset and WhatsApp is skipped (status "NOT_CONFIGURED"),
# nothing else breaks — official Meta WhatsApp Cloud API only, never an
# unofficial automation method.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
# The staff/business number (with country code, no "+") that should receive
# new-lead alerts, e.g. "919835266017".
WHATSAPP_NOTIFY_TO=""
