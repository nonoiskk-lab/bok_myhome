// Prisma schema for BOK MyHome — real estate sales & resale platform
// PostgreSQL (Supabase) datasource, used for both local dev and production.
//
// Fields that would naturally be enums are kept as plain Strings —
// constrained at the application layer — since this schema started on
// SQLite (no native enum support) and there's no reason to introduce a migration
// just to add native enums now; see src/lib/constants.ts for the canonical
// value lists (Role, PropertyType, TransactionType, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users, roles & agents
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("BUYER") // SUPER_ADMIN | ADMIN | AGENT | BUYER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agentProfile Agent?
  favorites    Favorite[]
  leads        Lead[]        @relation("LeadOwner")
  activityLogs ActivityLog[]
}

model Agent {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl    String?
  designation String?
  bio         String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  properties Property[]
  leads      Lead[]
}

// ---------------------------------------------------------------------------
// Locations
// ---------------------------------------------------------------------------

model Location {
  id          String  @id @default(cuid())
  city        String
  locality    String
  pincode     String?
  slug        String  @unique
  latitude    Float?
  longitude   Float?
  description String?

  properties Property[]

  @@index([city])
}

// ---------------------------------------------------------------------------
// Properties
// ---------------------------------------------------------------------------

model Property {
  id          String @id @default(cuid())
  propertyId  String @unique // human-facing e.g. BOK-10234
  slug        String @unique
  title       String
  description String

  propertyType    String // PropertyType
  transactionType String // TransactionType
  status          String // PropertyStatus (ready to move / under construction / new launch / resale)
  listingStatus   String  @default("PENDING_VERIFICATION") // ListingStatus
  featured        Boolean @default(false)
  premium         Boolean @default(false)
  verified        Boolean @default(false)

  price           Float
  priceNegotiable Boolean @default(false)
  pricePerSqft    Float?

  bedrooms     Int?
  bathrooms    Int?
  builtupArea  Float?
  carpetArea   Float?
  floor        Int?
  totalFloors  Int?
  propertyAge  Int?
  facing       String? // Facing
  furnishing   String? // Furnishing
  parking      Int?      @default(0)
  ownership    String?
  possessionOn DateTime?

  addressLine String?
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String

  agent   Agent?  @relation(fields: [agentId], references: [id])
  agentId String?

  views     Int      @default(0)
  enquiries Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       PropertyImage[]
  amenities    PropertyAmenity[]
  documents    PropertyDocument[]
  leads        Lead[]
  favorites    Favorite[]
  appointments Appointment[]
  inquiries    Inquiry[]

  @@index([propertyType])
  @@index([transactionType])
  @@index([listingStatus])
  @@index([locationId])
  @@index([price])
}

model PropertyImage {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  url        String
  alt        String?
  isCover    Boolean  @default(false)
  sortOrder  Int      @default(0)

  @@index([propertyId])
}

model PropertyDocument {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  name       String
  url        String
  createdAt  DateTime @default(now())
}

model Amenity {
  id   String  @id @default(cuid())
  name String  @unique
  icon String?

  properties PropertyAmenity[]
}

model PropertyAmenity {
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  amenityId  String

  @@id([propertyId, amenityId])
}

// ---------------------------------------------------------------------------
// Leads / CRM
// ---------------------------------------------------------------------------

// A Lead is one customer requirement/enquiry — the CRM's "Requirement"
// concept. Every Lead belongs to a Customer (the CRM's central record);
// one Customer can have many Leads over time (repeat enquiries).
model Lead {
  id      String  @id @default(cuid())
  name    String
  phone   String
  email   String?
  message String?
  budget  Float?
  source  String // LeadSource
  status  String  @default("NEW") // LeadStatus
  priority String @default("MEDIUM") // HIGH | MEDIUM | LOW

  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?

  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?

  agent   Agent?  @relation(fields: [agentId], references: [id])
  agentId String?

  user   User?   @relation("LeadOwner", fields: [userId], references: [id])
  userId String?

  preferredContactMethod String?
  preferredVisitDate     DateTime?
  nextFollowUp           DateTime?
  notes                  LeadNote[]
  followups              Followup[]
  activities             Activity[]

  // WhatsApp is a best-effort notification channel, not the source of
  // truth — Supabase already holds the lead regardless of this outcome.
  whatsappStatus String    @default("PENDING") // PENDING | SUCCESS | FAILED | NOT_CONFIGURED
  syncAttempts   Int       @default(0)
  lastSyncAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([customerId])
}

model LeadNote {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  body      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CRM — Customer is the central record; a Customer accumulates Leads
// (requirements), Followups and Activities over its whole lifetime.
// ---------------------------------------------------------------------------

model Customer {
  id           String   @id @default(cuid())
  name         String
  mobile       String   @unique // normalized 10-digit Indian mobile — primary dedup key
  email        String?
  company      String?
  customerType String   @default("INDIVIDUAL") // INDIVIDUAL | BUSINESS
  source       String   @default("WEBSITE")
  status       String   @default("NEW") // mirrors the most recent requirement's status
  priority     String   @default("MEDIUM") // HIGH | MEDIUM | LOW
  assignedTo   String?

  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads      Lead[]
  followups  Followup[]
  activities Activity[]
  notes      CustomerNote[]

  @@index([status])
  @@index([priority])
  @@index([nextFollowUpAt])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  body       String
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Followup {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId     String?
  dueAt      DateTime
  note       String?
  status     String   @default("PENDING") // PENDING | DONE | MISSED
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([dueAt])
}

model Activity {
  id          String   @id @default(cuid())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?
  type        String // ENQUIRY_RECEIVED | REQUIREMENT_ADDED | STATUS_CHANGED | PRIORITY_CHANGED | CONTACTED | FOLLOWUP_SCHEDULED | FOLLOWUP_COMPLETED | NOTE_ADDED | CONVERTED | LOST
  description String
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model Appointment {
  id            String   @id @default(cuid())
  property      Property @relation(fields: [propertyId], references: [id])
  propertyId    String
  name          String
  phone         String
  preferredDate DateTime
  preferredTime String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}

model Inquiry {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  type       String // GET_PRICE | CHECK_AVAILABILITY | MORE_INFO
  name       String
  phone      String
  email      String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Favorites & comparisons
// ---------------------------------------------------------------------------

model Favorite {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  sessionId  String?
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

// ---------------------------------------------------------------------------
// Content: blog / SEO
// ---------------------------------------------------------------------------

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts BlogPost[]
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String
  featuredImage   String?
  metaTitle       String?
  metaDescription String?
  author          String
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?
}

// ---------------------------------------------------------------------------
// Notifications & logs
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  meta      String?
  createdAt DateTime @default(now())
}
